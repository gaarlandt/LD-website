# Public env vars (NEXT_PUBLIC_* are inlined into the build).
# Copy to .env.local for local testing; set in Cloudflare Pages → Settings →
# Variables and Secrets for production builds.

# GA4 measurement ID. Must match the format G-XXXXXXXXXX.
# Leave empty to disable GA4 entirely (component renders nothing).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-0FCGXJHMMY

# Cookiebot Domain Group ID (UUID). Leave empty to disable the consent
# banner — useful for local dev when you don't want the banner in the way.
# NOTE: GA4 currently fires regardless of consent (no gating). The banner
# is shown for UX/legal-cover but doesn't gate tracking. See ga4.tsx for
# how to restore real consent gating if you change your mind.
NEXT_PUBLIC_COOKIEBOT_CBID=

# Cloudflare Pages reads NODE_VERSION from env to pin the build container's
# Node version. Set to 20 in Pages production env, not committed here.
# NODE_VERSION=20

# --- Contact form (Cloudflare Pages Function: functions/api/contact.ts) ---
# Postmark Server API token. SERVER-SIDE SECRET — do NOT prefix with
# NEXT_PUBLIC (that would inline it into the client bundle). Set it in
# Cloudflare Pages -> Settings -> Variables and Secrets, scoped to BOTH
# Production AND Preview. Without it, /api/contact returns HTTP 500.
# POSTMARK_SERVER_TOKEN=

# Optional overrides (the Function falls back to these defaults):
# CONTACT_TO=support@letsdog.nl
# CONTACT_FROM=noreply@letsdog.nl   # must be a Postmark-verified sender
