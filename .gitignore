# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# docs assets (too large for git)
docs/Brand Images/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# compound-engineering local config
.compound-engineering/*.local.yaml

# build worktrees (git worktree add .worktrees/<name>) — they are checkouts of
# this same repo, and an un-ignored one gets committed as an embedded git repo
# by any broad `git add`. That already happened once in the sister loop repo.
.worktrees/

# verify:live's own run log (T-61). Local by design: it records WHEN this
# machine wrote into production, so a later PostHog query can exclude the
# instrument's own traffic. Committing it would be pure churn — the durable
# copy is the run window pasted into the session LOG entry.
.verify-live-runs.log
